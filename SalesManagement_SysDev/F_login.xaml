<Window x:Class="SalesManagement_SysDev.F_login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売管理システムログイン画面"
        Width="816" Height="489" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Meiryo" FontSize="12">
    <Grid Margin="24,12,32,12">
        <TextBlock x:Name="Lbl_tag"
                   Text="このページはログイン画面として作成してください"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,100" />
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btn_CleateDabase"
                    Width="130" Height="49" Margin="0,0,0,21"
                    Click="btn_CleateDabase_Click">
                <TextBlock Text="データベース生成" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button x:Name="btn_InsertSampleData"
                    Width="130" Height="49"
                    Click="btn_InsertSampleData_Click">
                <TextBlock Text="サンプルデータ登録" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </StackPanel>
        <Button Content="Button" HorizontalAlignment="Left" Margin="242,313,0,0" VerticalAlignment="Top" Height="126" Width="253" Click="Button_Click"/>
    </Grid>
</Window>
